<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/choose"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Add photos" />

        <Button
            android:id="@+id/clear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Clear all" />
    </LinearLayout>

    <TextView
        android:id="@+id/count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:textColor="#FFFFFF" />

    <GridView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:horizontalSpacing="2dp"
        android:numColumns="3"
        android:verticalSpacing="2dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:background="#CC000000">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Watermark for all selected photos. Leave date or GPS empty to use each photo's own."
                android:textColor="#AAAAAA"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/fText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Custom text"
                android:inputType="text" />

            <EditText
                android:id="@+id/fDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Date (yyyy-MM-dd HH:mm:ss)"
                android:inputType="text" />

            <EditText
                android:id="@+id/fGps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="GPS (e.g. GPS: 33.573110, -7.589843)"
                android:inputType="text" />

            <EditText
                android:id="@+id/fAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Address / location name"
                android:inputType="text" />

            <Button
                android:id="@+id/apply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Apply to all" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
